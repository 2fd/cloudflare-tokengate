# Local development secrets. Copy to .dev.vars (git-ignored). In production use `wrangler secret put <NAME>`.

# Key-encryption key for stored credentials: 32 random bytes, base64.
# Generate OUTSIDE Cloudflare and keep a copy in your company vault: `openssl rand -base64 32`.
# Losing it means losing every stored credential. For rotation use TOKENGATE_KEYRING instead (docs/operations/key-rotation.md).
TOKENGATE_KEK=

# --- Local development only: operator variables ---
# In production these are plain variables set in the dashboard (Worker > Settings > Variables and
# Secrets); wrangler.jsonc declares none of them (keep_vars, I-DEPLOY-1). For `wrangler dev`, uncomment
# the ones you need in .dev.vars. They are commented here so the Deploy button does not ask for them
# as secrets. Full list and formats: docs/configuration.md.

# Origin the admin console is pinned to. http is accepted only for localhost.
# PUBLIC_URL=http://localhost:8787

# Comma-separated upstream hosts services may use ("api.example.com" or "*.example.com").
# ALLOWED_UPSTREAM_HOSTS=api.github.com,slack.com,hooks.slack.com

# Optional. Without it, the first person to sign in becomes owner; later sign-ins join as viewers.
# With it, only a listed email can become the first owner.
# BOOTSTRAP_OWNER_EMAILS=you@example.com

# Local development login: every admin request is signed in as this email, with no check at all.
# Accepted only when PUBLIC_URL is on localhost, 127.0.0.1 or [::1]. Never set it in production.
# AUTH_DEV_EMAIL=you@example.com

# Cloudflare Access login: "<team>" or "https://<team>.cloudflareaccess.com", and the application AUD.
# Requires PUBLIC_URL on a custom domain (not workers.dev). Production uses only this login.
# AUTH_ACCESS_TEAM_DOMAIN=
# AUTH_ACCESS_AUD=
